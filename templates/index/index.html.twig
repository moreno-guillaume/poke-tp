{% extends 'base.html.twig' %}

{% block title %}Pokdex - Accueil{% endblock %}

{% block body %}
    <h1>Bienvenue {{ app.user.userIdentifier }} !</h1>

    <p>Connexion BDD OK</p>

    <h2>Tables en base :</h2>
    {% if tables|length > 0 %}
        <ul>
            {% for table in tables %}
                <li>{{ table }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucune table</p>
    {% endif %}
{% endblock %}