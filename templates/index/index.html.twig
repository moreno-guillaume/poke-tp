{% extends 'base.html.twig' %}

{% block title %}Pokdex - Test{% endblock %}

{% block body %}
    <h1>Pokedex TP</h1>

    {% if db_connected %}
        <p>Connexion BDD OK</p>
    {% else %}
        <p>Connexion BDD KO</p>
    {% endif %}

    <h2>Tables en base :</h2>
    {% if tables|length > 0 %}
        <ul>
            {% for table in tables %}
                <li>{{ table }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucune table </p>
    {% endif %}
{% endblock %}