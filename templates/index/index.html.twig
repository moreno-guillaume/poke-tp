{% extends 'base.html.twig' %}

{% block title %}Pokedex - Accueil{% endblock %}

{% block body %}
    <h1>Bienvenue {{ app.user.userIdentifier }} !</h1>

    <h2>Mon Pokedex ({{ pokedex|length }}/{{ totalPokemons }})</h2>
    {% if pokedex|length > 0 %}
        <ul>
            {% for entry in pokedex %}
                <li>{{ entry.pokemon.label }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucun pokemon dans ton pokdex.</p>
    {% endif %}

    <hr>

    <h2>Tables en base :</h2>
    <ul>
        {% for table in tables %}
            <li>{{ table }}</li>
        {% endfor %}
    </ul>
{% endblock %}